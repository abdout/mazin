{
  // mazin (abdoutgroup.com) on the containerless $0 lane: vinext → one Worker with
  // Static Assets. No container, no Workers Cache, no KV cache, no Cloudflare Images.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mazin",
  "main": "cf/vinext-worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "vars": {
    "AUTH_URL": "https://abdoutgroup.com",
    "AUTH_TRUST_HOST": "true"
  },
  // v1 created the container's Durable Object; v2 retires it with the container lane.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MazinContainer"] },
    { "tag": "v2", "deleted_classes": ["MazinContainer"] }
  ],
  "triggers": { "crons": ["0 6 * * *", "0 8 * * *"] },
  "routes": [
    { "pattern": "abdoutgroup.com", "custom_domain": true },
    { "pattern": "www.abdoutgroup.com", "custom_domain": true }
  ]
}
