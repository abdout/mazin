// Shipment and Tracking Models
// This file contains models for shipment management and tracking

model Shipment {
  id             String         @id @default(cuid())
  shipmentNumber String         @unique
  trackingNumber String?        @unique // Public tracking number (TRK-XXXXXX)
  trackingSlug   String?        @unique // URL-safe slug for public tracking
  type           ShipmentType
  status         ShipmentStatus @default(PENDING)

  // Cargo details
  description     String
  weight          Decimal? @db.Decimal(10, 2)
  quantity        Int?
  containerNumber String?
  vesselName      String?

  // Parties
  consignor String // Shipper
  consignee String // Receiver

  // Dates
  arrivalDate   DateTime?
  departureDate DateTime?

  // Public tracking settings
  publicTrackingEnabled Boolean @default(true)

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Project relation (1:1 - shipment is auto-created with project)
  projectId String?  @unique
  project   Project? @relation("ProjectShipment", fields: [projectId], references: [id])

  // Client relation
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  // Demurrage tracking
  freeDays           Int?      @default(14)  // Free storage days at port
  demurrageDailyRate Decimal?  @db.Decimal(10, 2)  // Daily rate after free days
  demurrageStartDate DateTime?  // When demurrage counting starts (usually arrival + unloading)

  declarations   CustomsDeclaration[]
  invoices       Invoice[]
  trackingStages TrackingStage[]
  stageInvoices  StageInvoice[]
  notifications  Notification[]
  expenses       Expense[]
  acds           AdvanceCargoDeclaration[]
  containers     Container[]
  imForms        IMForm[]
  payments       ShipmentPayment[]
  documents      ShipmentDocument[]
  events         ShipmentEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shipmentNumber])
  @@index([trackingNumber])
  @@index([trackingSlug])
  @@index([status])
  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
  @@map("shipments")
}

enum ShipmentType {
  IMPORT
  EXPORT
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  CLEARED
  DELIVERED
}

// ============================================
// Tracking Stage Model
// ============================================

model TrackingStage {
  id         String              @id @default(cuid())
  shipmentId String
  shipment   Shipment            @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  stageType  TrackingStageType
  status     TrackingStageStatus @default(PENDING)

  // Timestamps
  startedAt   DateTime? // When stage was started
  completedAt DateTime? // When stage was completed
  estimatedAt DateTime? // ETA for this stage

  // Metadata
  notes       String? // Staff notes for this stage
  updatedById String? // User who last updated this stage

  // Payment tracking for this stage
  paymentRequested Boolean @default(false) // Invoice sent for this stage
  paymentReceived  Boolean @default(false) // Payment received

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentId, stageType])
  @@index([shipmentId])
  @@index([status])
  @@index([paymentRequested])
  @@map("tracking_stages")
}

enum TrackingStageType {
  PRE_ARRIVAL_DOCS
  VESSEL_ARRIVAL
  CUSTOMS_DECLARATION
  CUSTOMS_PAYMENT
  INSPECTION
  PORT_FEES
  QUALITY_STANDARDS
  RELEASE
  LOADING
  IN_TRANSIT
  DELIVERED
}

enum TrackingStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ============================================
// Shipment Event (operational activity feed)
// ============================================
//
// `AuditLog` is the security-grade record (who-changed-what for compliance).
// `ShipmentEvent` is the operator-facing activity feed: a single chronological
// stream of "what happened on this shipment" for the cockpit and the per-shipment
// timeline. Records are written from server actions (tracking advance, doc upload,
// payment recorded, OCR extracted, compliance finding…) and are user-readable.
model ShipmentEvent {
  id         String  @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // Actor: usually the staff user who triggered the change. NULL for system events
  // (cron-driven status flips, automated stage advances).
  actorId String?
  actor   User?  @relation("ShipmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  kind        ShipmentEventKind
  // Bilingual one-line summary suitable for direct rendering in the activity feed.
  summary     String   @db.Text
  summaryAr   String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([shipmentId, createdAt])
  @@index([actorId, createdAt])
  @@index([kind, createdAt])
  @@map("shipment_events")
}

enum ShipmentEventKind {
  CREATED
  STAGE_ADVANCED
  STAGE_SKIPPED
  STATUS_CHANGED
  DOCUMENT_UPLOADED
  DOCUMENT_VERIFIED
  DOCUMENT_REJECTED
  PAYMENT_RECORDED
  PAYMENT_CONFIRMED
  CUSTOMS_DECLARATION_FILED
  ACD_GENERATED
  IM_FORM_LINKED
  CONTAINER_ADDED
  CONTAINER_RELEASED
  INVOICE_ISSUED
  INVOICE_PAID
  COMPLIANCE_FINDING
  TASK_CREATED
  TASK_COMPLETED
  NOTE_ADDED
  OTHER
}
